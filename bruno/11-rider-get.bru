meta {
  name: Get rider
  type: http
  seq: 11
}

get {
  url: {{baseUrl}}/api/riders/{{riderId}}
  body: none
  auth: none
}

tests {
  test("status 200", function () {
    expect(res.status).to.equal(200);
  });
  test("returns created id", function () {
    expect(res.body.id === bru.getVar("riderId")).to.be.true;
  });
}
