meta {
  name: Get station
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/stations/{{stationId}}
  body: none
  auth: none
}

tests {
  test("status 200", function () {
    expect(res.status).to.equal(200);
  });
  test("returns created id", function () {
    expect(res.body.id === bru.getVar("stationId")).to.be.true;
  });
}
