meta {
  name: Get dock
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/api/docks/{{dockId}}
  body: none
  auth: none
}

tests {
  test("status 200", function () {
    expect(res.status).to.equal(200);
  });
  test("returns created id", function () {
    expect(res.body.id === bru.getVar("dockId")).to.be.true;
  });
}
