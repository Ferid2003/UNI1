meta {
  name: Update dock
  type: http
  seq: 8
}

put {
  url: {{baseUrl}}/api/docks/{{dockId}}
  body: json
  auth: none
}

body:json {
  {
    "dockNumber": 1,
    "status": "OCCUPIED",
    "stationId": {{stationId}}
  }
}

tests {
  test("status 200", function () {
    expect(res.status).to.equal(200);
  });
  test("field updated", function () {
    expect(res.body.status === "OCCUPIED").to.be.true;
  });
}
