meta {
  name: Create station
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/stations
  body: json
  auth: none
}

body:json {
  {
    "name": "Central",
    "address": "1 Main St",
    "latitude": 41.311081,
    "longitude": 69.240562,
    "isActive": true
  }
}

script:post-response {
  bru.setVar("stationId", res.body.id);
}

tests {
  test("status 201", function () {
    expect(res.status).to.equal(201);
  });
  test("has id", function () {
    expect(res.body.id !== undefined).to.be.true;
  });
}
